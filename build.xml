<?xml version="1.0" encoding="UTF-8"?>
<project name="lab4" default="build">

    <property file="build.properties"/>
    <property name="libs.dir" value="libs"/>

    <path id="project.classpath">
        <fileset dir="${lib.dir}">
            <include name="**/*.jar"/>
        </fileset>
        <fileset dir="${libs.dir}">
            <include name="**/*.jar"/>
        </fileset>
    </path>


    <target name="init">
        <exec executable="mvn" failonerror="true">
            <arg value="dependency:copy-dependencies"/>
        </exec>

        <mkdir dir="${build}"/>
        <mkdir dir="${build.classes}"/>
    </target>

    <target name="compile" depends="init">
        <javac
                srcdir="${src}"
                destdir="${build.classes}"
                classpathref="project.classpath"
                nowarn="on"
        />

        <copy todir="${build.classes}">
            <fileset dir="src/main/resources"/>
        </copy>
    </target>

    <target name="build" depends="compile, xml">
        <mkdir dir="${fatlib.dir}"/>
        <unzip dest="${fatlib.dir}">
            <fileset dir="${lib.dir}" includes="*.jar"/>
        </unzip>

        <jar destfile="${dest.file}">
            <fileset dir="${build.classes}"/>
            <fileset dir="${fatlib.dir}"/>
            <manifest>
                <attribute name="Main-Class" value="itmo.lab.web4.Web4Application"/>
            </manifest>
        </jar>
    </target>

    <target name="clean">
        <delete dir="${build}"/>
        <delete dir="${target}"/>
    </target>

    <target name="xml">
        <xmlvalidate file="pom.xml" lenient="yes"/>
    </target>



    <target name="test" depends="compile">
        <mkdir dir="${test.classes.dir}"/>
        <mkdir dir="${test.reports.dir}"/>

        <path id="test.compile.classpath">
            <path refid="project.classpath"/>
            <pathelement path="${build.classes}"/>
            <fileset dir="${libs.dir}">
                <include name="junit-4.13.2.jar"/>
                <include name="hamcrest-core-1.3.jar"/>
                <include name="mockito-core-*.jar"/>
                <include name="objenesis-*.jar"/>
            </fileset>
        </path>

        <javac
                srcdir="${test.src}"
                destdir="${test.classes.dir}"
                classpathref="test.compile.classpath"
                nowarn="on"
                includeantruntime="false"
        />

        <junit printsummary="yes" haltonfailure="no" fork="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${build.classes}"/>
                <pathelement path="${test.classes.dir}"/>
                <fileset dir="${libs.dir}">
                    <include name="junit-4.13.2.jar"/>
                    <include name="hamcrest-core-1.3.jar"/>
                    <include name="mockito-core-*.jar"/>
                    <include name="objenesis-*.jar"/>
                </fileset>
            </classpath>

            <formatter type="plain" usefile="false"/>
            <formatter type="xml"/>

            <batchtest todir="${test.reports.dir}">
                <fileset dir="${test.classes.dir}">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>
    </target>

    <target name="native2ascii">
        <delete dir="${native2ascii.resources}"/>
        <native2ascii src="${resources.dir}"
                      dest="${native2ascii.resources}"
                      includes="**/*.properties"/>
    </target>

    <target name="music" depends="build">
        <java classname="MusicPlayer" fork="true">
            <classpath>
                <path refid="project.classpath"/>
                <pathelement path="${build.classes}"/>
            </classpath>
            <arg value="${src}/gaiti.wav"/>
        </java>
    </target>

    <target name="alt" depends="compile" description="Creates alternative version with renamed classes">
        <property name="alt.src.dir" value="${build}/alt-src"/>
        <mkdir dir="${alt.src.dir}"/>

        <copy todir="${alt.src.dir}">
            <fileset dir="${src}"/>
        </copy>



        <replaceregexp match="${alt.user.regex}" replace="${alt.user}" flags="">
            <fileset dir="${alt.src.dir}" includes="**/*.java"/>
        </replaceregexp>

        <antcall target="build">
            <param name="src" value="${alt.src.dir}"/>
            <param name="build.classes" value="${build}/alt-classes"/>
            <param name="dest.file" value="alt-${dest.file}"/>
        </antcall>

        <echo message="Alternative version built: alt-${dest.file}"/>
    </target>



    <target name="team"/>

    <target name="env"/>

</project>